generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WAREHOUSE_MANAGER
  STORE_KEEPER
  VIEWER
}

enum ItemType {
  BLOCK
  SLAB
  TILE
  CUT_TO_SIZE
  RESIDUAL
  CONSUMABLE
}

enum QualityStatus {
  AVAILABLE
  QUARANTINE
  RESERVED
  SOLD
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum StockTransactionType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  STOCK_COUNT
}

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  passwordHash       String
  role               Role               @default(VIEWER)
  isActive           Boolean            @default(true)
  refreshTokens      RefreshToken[]
  stockTransactions  StockTransaction[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Item {
  id              String         @id @default(uuid())
  sku             String         @unique
  name            String
  type            ItemType
  uniqueBlockId   String?        @unique
  uniqueSlabId    String?        @unique
  quarryOrigin    String?
  color           String?
  veinPattern     String?
  qualityGrade    String?
  finish          String?
  thicknessMm     Decimal?
  lengthMm        Decimal?
  widthMm         Decimal?
  weightKg        Decimal?
  areaSqm         Decimal?
  recoveryPercent Decimal?
  qualityStatus   QualityStatus  @default(AVAILABLE)
  parentId        String?
  parent          Item?          @relation("ItemTraceability", fields: [parentId], references: [id])
  children        Item[]         @relation("ItemTraceability")
  photos          ItemPhoto[]
  balances        StockBalance[]
  transactions    StockTransaction[]
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([type, qualityStatus])
  @@index([qualityGrade, finish])
  @@index([quarryOrigin])
}

model ItemPhoto {
  id        String   @id @default(uuid())
  itemId    String
  url       String
  caption   String?
  sortOrder Int      @default(0)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

model Warehouse {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  address   String?
  isActive  Boolean    @default(true)
  locations Location[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Location {
  id             String         @id @default(uuid())
  warehouseId    String
  code           String
  name           String?
  status         LocationStatus @default(ACTIVE)
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stock          StockBalance[]
  transfersFrom  StockTransaction[] @relation("StockFrom")
  transfersTo    StockTransaction[] @relation("StockTo")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([warehouseId, code])
  @@index([warehouseId, status])
}

model StockBalance {
  id            String        @id @default(uuid())
  itemId        String
  locationId    String
  qualityStatus QualityStatus
  quantity      Decimal       @default(0)
  areaSqm       Decimal       @default(0)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  updatedAt     DateTime      @updatedAt

  @@unique([itemId, locationId, qualityStatus])
  @@index([locationId, qualityStatus])
}

model StockTransaction {
  id             String               @id @default(uuid())
  transactionNo  String               @unique
  type           StockTransactionType
  itemId         String
  fromLocationId String?
  toLocationId   String?
  qualityStatus  QualityStatus
  quantity       Decimal
  areaSqm        Decimal              @default(0)
  referenceType  String?
  referenceId    String?
  note           String?
  actorId        String
  createdAt      DateTime             @default(now())
  item           Item                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromLocation   Location?            @relation("StockFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    Location?            @relation("StockTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  actor          User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([type, createdAt])
  @@index([qualityStatus])
  @@index([fromLocationId, toLocationId])
}
